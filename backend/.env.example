PROJECT_NAME=VendorSaathi Backend API
API_V1_STR=/api/v1
SECRET_KEY=vendorsathi_jwt_secret_key_change_in_production_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for seamless local Windows dev, switch to PostgreSQL when ready)
DATABASE_URL=sqlite:///./vendorsathi.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8002","*"]

# Operational Mode
DEMO_MODE=true

# External Service Keys (Optional - gracefully falls back to Open-Meteo & OSRM Open Source endpoints)
OPENWEATHER_API_KEY=
OPENROUTESERVICE_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# SMS / OTP delivery (optional). Leave blank to keep the on-screen demo code.
#
# Fast2SMS (recommended free option for India): sign up at fast2sms.com and paste
# the Dev API authorization key. The "otp" route needs no DLT and reaches any
# Indian number. Comes with ~₹50 free credit.
FAST2SMS_API_KEY=
#
# MSG91 (production): requires a DLT-registered Sender ID + template.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_ROUTE=4
MSG91_OTP_VAR=VAR1
MSG91_COUNTRY_CODE=91
